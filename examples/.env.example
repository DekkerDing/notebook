# Redis集群配置示例
# 复制此文件为 .env 并填入实际值

# Redis集群连接
REDIS_CLUSTER_NODES=192.168.10.107:6379,192.168.10.107:6380,192.168.10.107:6381,192.168.10.109:6379,192.168.10.109:6380,192.168.10.109:6381
REDIS_PASSWORD=your_redis_password_here

# Stream配置
REDIS_STREAM_ENABLED=true
REDIS_STREAM_KEY_PREFIX=examplesApplication:stream:
REDIS_STREAM_GROUP=default-group
REDIS_STREAM_CONSUMER=examples-consumer
REDIS_STREAM_POLL_TIMEOUT=2000
REDIS_STREAM_BATCH_SIZE=10

# 分区配置
REDIS_PARTITION_ENABLED=false
REDIS_PARTITION_COUNT=3
REDIS_PARTITION_STRATEGY=hash

# 幂等性配置
REDIS_IDEMPOTENT_ENABLED=true
REDIS_IDEMPOTENT_TTL=86400

# 重试配置
REDIS_RETRY_MAX_ATTEMPTS=3
REDIS_RETRY_INITIAL_INTERVAL=1000
REDIS_RETRY_BACKOFF_MULTIPLIER=2.0

# DLQ配置
REDIS_DLQ_ENABLED=true
REDIS_DLQ_KEY_PREFIX=examplesApplication:dlq:

# 应用配置
REDIS_KEY_PREFIX=examplesApplication:
LOG_LEVEL=INFO

# 监控配置
PROMETHEUS_ENABLED=false
